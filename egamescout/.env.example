# ============================================================
# E-GameScout — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env to version control!
# ============================================================

# ---- Django ----
SECRET_KEY=your-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,https://your-ec2-domain.com

# ---- Database (XAMPP MySQL defaults) ----
DB_NAME=egamescout
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Email (Gmail SMTP) ----
# Leave blank to use console backend (prints to terminal instead of sending)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# ---- AI — Google Gemini (Scorecard AI) ----
# Add up to 3 keys for automatic fallback
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3

# ---- AI — Groq (Fallback if all Gemini keys fail) ----
GROQ_API_KEY=your-groq-api-key-here
